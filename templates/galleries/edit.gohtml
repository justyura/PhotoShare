{{ define "delete_image_form" }}
<form action="/images/{{.UUID}}/delete" 
    method="post" 
    onsubmit="return confirm('Do you really want to delete this image?');"> 
    {{csrfField}} 
    <button type="submit" class=" p-1 text-xs text-red-800 bg-red-100 border border-red-400 rounded " >
	Delete 
    </button> 
</form> 
{{end}}
{{template "header" .}} 
<div class="p-8 w-full"> 
    <h1 class="pt-4 pb-8 text-3xl font-bold text-gray-800">
	Edit your Gallery 
    </h1> 
    <form action="/galleries/{{.ID}}" method="post"> 
	<div class="hidden">
	    {{csrfField}}
	</div> 
	<div class="py-2">
	    <label for="title" class="text-sm font-semibold text-gray-800"> 
		Title 
	    </label> 
	    <input name="title" id="title" type="text" placeholder="Gallery Title" required class=" w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-800 rounded " value="{{.Title}}" autofocus /> 
	</div> 
	<div class="py-4"> 
	    <button type="submit" class=" py-2 px-8 bg-indigo-600 hover:bg-indigo-700 text-white rounded font-bold text-lg " > 
		Update 
	    </button> 
	</div>
    </form> 
    <div class="py-4"> 
	{{template "upload_image_form" .}} 
    </div>
        <!-- API tokens -->
    {{if .NewToken}}
    <div class="my-4 p-4 bg-green-50 border border-green-400 rounded">
	<p class="text-sm font-semibold text-green-900">
	    Token created. This is the only time it will be shown — copy it now.
	</p>
	<code class="block my-2 p-2 text-xs bg-white border border-green-300 rounded break-all">{{.NewToken}}</code>
	<p class="text-xs text-green-900">Upload with:</p>
	<pre class="my-1 p-2 text-xs bg-white border border-green-300 rounded overflow-x-auto">curl -H "Authorization: Bearer {{.NewToken}}" \
     -F "file=@photo.jpg" \
     {{.BaseURL}}/api/v1/upload</pre>
    </div>
    {{end}}

    <div class="py-4">
	<h2 class="pb-2 text-sm font-semibold text-gray-800">API Tokens</h2>
	<p class="pb-2 text-xs text-gray-600">
	    A token uploads straight into this gallery. Revoke one at any time.
	</p>
	{{range .Tokens}}
	<div class="flex items-center gap-2 py-1">
	    <span class="text-xs text-gray-700">Token #{{.ID}}</span>
	    <form action="/galleries/{{$.ID}}/tokens/{{.ID}}/delete"
		method="post"
		onsubmit="return confirm('Revoke this token?');">
		{{csrfField}}
		<button type="submit" class="p-1 text-xs text-red-800 bg-red-100 border border-red-400 rounded">
		    Revoke
		</button>
	    </form>
	</div>
	{{end}}
	<form action="/galleries/{{.ID}}/tokens" method="post" class="pt-2">
	    {{csrfField}}
	    <button type="submit" class="py-1 px-4 text-sm bg-indigo-600 hover:bg-indigo-700 text-white rounded">
		Generate token
	    </button>
	</form>
    </div>
    <!-- Images -->
    <div class="py-4">
	<h2 class="pb-2 text-sm font-semibold text-gray-800">
	    Current Images
	</h2> 
	<div class="py-2 grid grid-cols-8 gap-2"> 
	    {{range .Images}} 
	    <div class="h-min w-full relative"> 
		<div class="absolute top-2 right-2"> 
		    {{template "delete_image_form" .}}
		</div>
		<img class="w-full" src="/i/{{.UUID}}{{.Ext}}" alt="{{.OrigName}}" loading="lazy">
	    </div>
	    {{end}}
	</div>
    </div> 
    <div class="py-4">
	<h2>Dangerous actions</h2>
	<form action="/galleries/{{.ID}}/delete" method="post" onsubmit="return confirm('Do you really want to delete this gallery?');">
	    <div class="hidden"> 
		{{csrfField}}
	    </div> 
	    <button type="submit" class=" py-2 px-8 bg-red-600 hover:bg-red-700 text-white rounded font-bold text-lg " >
		Delete
	    </button>
	</form> 
    </div> 
</div> 
{{template "footer" .}} 

{{define "upload_image_form"}}
<form action="/galleries/{{.ID}}/images" 
    method="post" 
    enctype="multipart/form-data">
    {{csrfField}}
    <div class="py-2">
	<label for="images" 
	    class="block mb-2 text-sm font-semibold text-gray-800">
	    Add Images 
	    <p class="py-2 text-xs text-gray-600 font-normal"> 
		Please only upload jpg, png, and gif files. 
	    </p> 
	</label>
	<input type="file" multiple accept="image/png, image/jpeg, image/gif" id="images" name="images" />
    </div> 
    <button type="submit" 
	class=" py-2 px-8 bg-indigo-600 hover:bg-indigo-700 text-white text-lg font-bold rounded "> 
	Upload 
    </button> 
</form> 
{{end}}
